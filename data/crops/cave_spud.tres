[gd_resource type="Resource" script_class="CropDef" format=3]

[ext_resource type="Script" path="res://data/crops/crop_def.gd" id="1_def"]
[ext_resource type="Script" path="res://data/crops/crop_yield_tier.gd" id="2_tier"]
[ext_resource type="Script" path="res://data/items/item_amount.gd" id="3_amount"]
[ext_resource type="Resource" path="res://data/items/cave_spud.tres" id="4_spud"]

[sub_resource type="Resource" id="Resource_spud_half_item"]
script = ExtResource("3_amount")
item_def = ExtResource("4_spud")
count = 4

[sub_resource type="Resource" id="Resource_spud_full_item"]
script = ExtResource("3_amount")
item_def = ExtResource("4_spud")
count = 10

[sub_resource type="Resource" id="Resource_spud_tier_half"]
script = ExtResource("2_tier")
min_growth_progress = 0.5
yields = Array[ExtResource("3_amount")]([SubResource("Resource_spud_half_item")])

[sub_resource type="Resource" id="Resource_spud_tier_full"]
script = ExtResource("2_tier")
min_growth_progress = 1.0
yields = Array[ExtResource("3_amount")]([SubResource("Resource_spud_full_item")])

[resource]
resource_name = "Cave Spud"
script = ExtResource("1_def")
id = "cave_spud"
display_name = "Cave Spud"
growth_time_hours = 12.0
growth_stages = 3
max_water = 100.0
water_decay_per_hour = 1.0
thirsty_threshold = 30.0
tending_mode = 0
yield_tiers = Array[ExtResource("2_tier")]([SubResource("Resource_spud_tier_half"), SubResource("Resource_spud_tier_full")])
base_harvest_time = 2.0
