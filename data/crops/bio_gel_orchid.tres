[gd_resource type="Resource" script_class="CropDef" format=3]

[ext_resource type="Script" path="res://data/crops/crop_def.gd" id="1_def"]
[ext_resource type="Script" path="res://data/crops/crop_yield_tier.gd" id="2_tier"]
[ext_resource type="Script" path="res://data/items/item_amount.gd" id="3_amount"]
[ext_resource type="Resource" path="res://data/items/bio_gel_orchid.tres" id="4_orchid"]
[ext_resource type="Script" path="res://subsystems/actions/condition.gd" id="5_cond"]
[ext_resource type="Script" path="res://data/conditions/min_skill_condition.gd" id="6_skill"]
[ext_resource type="Script" path="res://data/conditions/has_item_condition.gd" id="7_tool"]

[sub_resource type="Resource" id="Resource_orchid_half_item"]
script = ExtResource("3_amount")
item_def = ExtResource("4_orchid")
count = 1

[sub_resource type="Resource" id="Resource_orchid_full_item"]
script = ExtResource("3_amount")
item_def = ExtResource("4_orchid")
count = 4

[sub_resource type="Resource" id="Resource_orchid_tier_half"]
script = ExtResource("2_tier")
min_growth_progress = 0.5
yields = Array[ExtResource("3_amount")]([SubResource("Resource_orchid_half_item")])

[sub_resource type="Resource" id="Resource_orchid_tier_full"]
script = ExtResource("2_tier")
min_growth_progress = 1.0
yields = Array[ExtResource("3_amount")]([SubResource("Resource_orchid_full_item")])

[sub_resource type="Resource" id="Resource_orchid_skill_gate"]
script = ExtResource("6_skill")
skill_id = "farming"
min_level = 2

[sub_resource type="Resource" id="Resource_orchid_tool_gate"]
script = ExtResource("7_tool")
item_tag = "gardening_tool"
count = 1

[resource]
resource_name = "Bio-Gel Orchid"
script = ExtResource("1_def")
id = "bio_gel_orchid"
display_name = "Bio-Gel Orchid"
growth_time_hours = 24.0
growth_stages = 3
max_water = 100.0
water_decay_per_hour = 8.0
thirsty_threshold = 30.0
tending_mode = 2
tending_decay_hours = 6.0
untended_growth_mult = 0.0
neglect_hours = 4.0
neglect_yield_penalty = 0.5
tend_conditions = Array[ExtResource("5_cond")]([SubResource("Resource_orchid_skill_gate"), SubResource("Resource_orchid_tool_gate")])
yield_tiers = Array[ExtResource("2_tier")]([SubResource("Resource_orchid_tier_half"), SubResource("Resource_orchid_tier_full")])
base_harvest_time = 4.0
