[node name="ApplyButton" type="Button" parent="MainRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Apply"

[node name="SaveAsButton" type="Button" parent="MainRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Save as..."

[node name="SaveRow" type="HBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="SaveNameInput" type="LineEdit" parent="SaveRow"]
